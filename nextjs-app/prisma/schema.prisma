// datasource db defines the database connection details.
datasource db {
  provider = "mysql" // Specifies the database provider (MySQL in this case).
  url      = env("DATABASE_URL") // Sets the database connection URL from an environment variable.
}

// generator client defines how the Prisma Client is generated.
generator client {
  provider = "prisma-client-js" // Specifies that Prisma Client for JavaScript should be generated.
}

// Represents administrative settings for ships.
model AdminShip {
  ship_type_id Int      @id // Unique identifier for the ship type.
  status       Boolean  @default(true) // Status of the ship type (e.g., active/inactive).
  ship_type    ShipType @relation(fields: [ship_type_id], references: [type_id]) // Relation to ShipType model
}

// Represents a user's bank account information.
model BankAccount {
  login_id Int         @id // Unique identifier for the login, also primary key.
  loan     Int         @default(0) // Amount of loan taken by the user.
  deposit  Int         @default(0) // Amount of deposit made by the user.
  user     UserAccount @relation(fields: [login_id], references: [login_id]) // Relation to the UserAccount model.
}

// Represents items available in Bilko's market.
model Bilko {
  item_id     Int     @id @default(autoincrement()) // Unique identifier for the item.
  item_name   String  @default("") // Name of the item.
  item_code   String  @default("") // Code of the item.
  item_type   Int     @default(0) // Type of the item.
  bidder_id   Int? // Identifier of the current highest bidder. SQL: int(11) NOT NULL default '0'. Nullable if 0 means no bidder.
  bidder      User?   @relation("BilkoBids", fields: [bidder_id], references: [login_id]) // Relation to the User who is the bidder
  going_price Int     @default(0) // Current highest bid price.
  timestamp   Int     @default(0) // Timestamp of the last bid.
  active      Boolean @default(false) // SQL: tinyint(4) NOT NULL default '0'.
  descr       String  @default("") @db.Text // SQL: text NOT NULL
}

// Represents power-ups in the game.
model Powerup {
  id            Int     @id @default(autoincrement()) // Unique identifier for the power-up.
  name          String  @default("Junk") // Name of the power-up.
  amount        BigInt  @default(0) // Amount or quantity of the power-up.
  type          String  @default("cash") // Type of the power-up (e.g., cash, item).
  table         String  @default("users") // Table associated with the power-up.
  user_relation String  @default("login_id") // User relation field.
  location      BigInt  @default(0) // Location identifier for the power-up.
  desc          String  @default("Looks like you found useless junk, too bad.") // Description of the power-up.
}

// Represents black markets in the game.
model Bmrkt {
  bmrkt_id      Int     @id @default(autoincrement()) // Unique identifier for the black market.
  location      Int     @default(0) // Location of the black market (references a Star system).
  star          Star    @relation("BmrktInStar", fields: [location], references: [star_id])
  tech_variance Int     @default(0) // Variance in technology level.
  bmrkt_type    Int     @default(0) @db.TinyInt // SQL: tinyint(4) NOT NULL default '0'
  bm_name       String  @default("") // Name of the black market.
  bm_move       Int     @default(1) // Movement points associated with the black market.
}

// Represents messages in a clan forum.
model ClanForumMessage {
  message_id  Int    @id @default(autoincrement()) // Unique identifier for the message.
  sender_name String @default("") // Name of the sender.
  timestamp   Int    @default(0) // Timestamp of when the message was sent.
  login_id    Int    // Login ID of the sender.
  sender      User   @relation("ClanForumSender", fields: [login_id], references: [login_id])
  clan_id     Int    @db.UnsignedInt // ID of the clan the forum belongs to.
  clan        Clan   @relation(fields: [clan_id], references: [clan_id])
  subject     String @default("") @db.VarChar(50)
  text        String @db.Text // Content of the message. SQL: blob NOT NULL, assumed text
  sender_id   Int    @default(1) @db.UnsignedInt // Sender ID (alternative identifier).  //This might be a duplicate of login_id or refer to UserAccount
  reply_to    Int    @default(0) @db.UnsignedInt // ID of the message this is a reply to.
  // repliedMessage ClanForumMessage? @relation("Replies", fields: [reply_to], references: [message_id], onDelete: NoAction, onUpdate: NoAction)
  // replies        ClanForumMessage[] @relation("Replies")
}

// Represents relationships between clans (e.g., alliances, wars).
model ClanRelation {
  relation_id Int     @id @default(autoincrement()) @unique
  clan_id     Int     // ID of the first clan. SQL: clan_id int(11) NOT NULL default '0'
  clan1       Clan    @relation("ClanRelations1", fields: [clan_id], references: [clan_id])
  v_clan_id   Int     // ID of the second clan. SQL: v_clan_id int(11) NOT NULL default '0'
  clan2       Clan    @relation("ClanRelations2", fields: [v_clan_id], references: [clan_id])
  nap_agree   Boolean @default(false) // SQL: tinyint(4) NOT NULL default '0'
  type        Int     @default(0) @db.TinyInt // SQL: type tinyint(4) NOT NULL default '0'
}

// Represents clans in the game.
model Clan {
  clan_id       Int    @id @default(autoincrement()) @db.UnsignedInt
  clan_name     String @default("") @db.VarChar(30)
  passwd        String @default("") @db.VarChar(25)
  leader_id     Int?   // Login ID of the clan leader. SQL: int(11) NOT NULL default '0'. Made nullable if 0 means no leader.
  leader        User?  @relation("ClanLeader", fields: [leader_id], references: [login_id])
  members       Int    @default(1)
  symbol        String @default("") @db.Char(3)
  sym_color     String @default("") @db.VarChar(6)
  clan_score    Int    @default(0)
  fighter_kills Int     @default(0) // Number of fighter kills by the clan.
  // forum_messages ClanForumMessage[]
  relations1     ClanRelation[]   @relation("ClanRelations1")
  relations2     ClanRelation[]   @relation("ClanRelations2")
  // users          User[] // This relation is managed from User.clan
  fleets         Fleet[]          @relation("ClanFleets")
  mines          Mine[]           @relation("ClanMines")
  forum_messages ClanForumMessage[]
  ships          Ship[]           @relation("ClanShips") // Added inverse relation
  upgrade_records UpgradeUnit[]    @relation("ClanUpgradeRecords")
}

// Represents game database variables and settings.
model DbVar {
  type     Int    @default(0) // Type of the variable.
  name     String @id @default("0") // Name of the variable (primary key).
  value    String @default("0") // Value of the variable.
  min      Int    @default(1) // Minimum allowed value.
  max      Int    @default(1) // Maximum allowed value.
  descript String // Description of the variable.
}

// Represents diary entries for users.
model DiaryEntry {
  entry_id  Int   @id @default(autoincrement()) @unique // Unique identifier for the diary entry.
  timestamp Int    @default(0) // Timestamp of the entry.
  login_id  Int    // Login ID of the user who wrote the entry.
  user      User   @relation("UserDiaryEntries", fields: [login_id], references: [login_id])
  entry     String @db.Text // Content of the diary entry. SQL: blob NOT NULL
  topic     String @db.Text // Topic of the diary entry. SQL: blob NOT NULL

  @@index([entry_id, timestamp])
}

// Represents fines imposed on players.
model Fine {
  fine_id    Int     @id @default(autoincrement()) @unique // Unique identifier for the fine.
  login_id   Int     // Login ID of the player who received the fine.
  user       User    @relation("UserFines", fields: [login_id], references: [login_id])
  login_name String  @default("") @db.VarChar(30) // SQL: varchar(30) NOT NULL default ''
  amount     Int     @default(0) // Amount of the fine.
  bounty     Int     @default(0) // Bounty associated with the fine.
  overdue    Boolean @default(false) // Whether the fine is overdue.
  paid       Boolean @default(false) // Whether the fine has been paid.
}

// Represents player fleets.
model Fleet {
  fleet_id   Int     @id @default(autoincrement()) // Unique identifier for the fleet.
  fleet_name String  @default("") // Name of the fleet.
  fleet_num  Int     @default(0) @db.UnsignedInt
  login_name String  @default("") @db.VarChar(30)
  login_id   Int     @db.UnsignedInt // Login ID of the fleet owner.
  owner      User    @relation("UserFleets", fields: [login_id], references: [login_id])
  clan_id    Int?    @db.UnsignedInt // Clan ID the fleet belongs to. clan_id = 0 means no clan.
  clan       Clan?   @relation("ClanFleets", fields: [clan_id], references: [clan_id])
  fleet_link Int     @default(0) @db.UnsignedInt
  location   Int     @default(0) @db.UnsignedInt // Current location (star system ID) of the fleet.
  star       Star    @relation("FleetsInSystem", fields: [location], references: [star_id])
  ship_id    Int     @default(0) @db.UnsignedInt // ID of the flagship or a representative ship.
  ramscoop   Int     @default(0) @db.UnsignedInt
  scatter    Boolean @default(false) @db.TinyInt // SQL: tinyint(1) unsigned NOT NULL default '0'
  ships      Ship[]  @relation("ShipsInFleet") // Ships belonging to this fleet
  upgrades   UpgradeUnit[] @relation("FleetUpgradesCache")// Upgrade units for ships in this fleet
}

// Represents messages in the global game forum.
model GameForumMessage {
  message_id  Int    @id @default(autoincrement()) // Unique identifier for the message.
  sender_name String @default("") // Name of the sender.
  timestamp   Int    @default(0) @db.UnsignedInt
  login_id    Int    @db.UnsignedInt // Login ID of the sender. SQL: login_id int(11) unsigned NOT NULL default '0'
  sender      User   @relation("UserGameForumMessages", fields: [login_id], references: [login_id])
  subject     String @default("") @db.VarChar(50)
  text        String @db.Text // Content of the message. SQL: blob NOT NULL, assumed text
  sender_id   Int    @default(1) @db.UnsignedInt // Alternative sender ID. SQL: sender_id int(11) unsigned NOT NULL default '1'
  clan_id     Int    @default(0) @db.UnsignedInt // Clan ID of the sender (if applicable). SQL: clan_id int(11) unsigned NOT NULL default '0'
  reply_to    Int    @default(0) @db.UnsignedInt // ID of the message this is a reply to. SQL: reply_to int(11) unsigned NOT NULL default '0'
  // repliedMessage GameForumMessage? @relation("GameReplies", fields: [reply_to], references: [message_id], onDelete: NoAction, onUpdate: NoAction) // This relation needs a list on the other side
  // replies        GameForumMessage[] @relation("GameReplies")

  @@index([login_id])
  @@index([timestamp])
}

// Represents resource indices for market calculations.
model Index {
  index_id Int @id @default(autoincrement()) // Unique identifier for the index record.
  metal    Int @default(1000) // Metal index value.
  fuel     Int @default(1000) // Fuel index value.
  organ    Int @default(1000) // Organics index value.
  elect    Int @default(1000) // Electronics index value.

  @@index([metal])
  @@index([fuel])
  @@index([organ])
  @@index([elect])
}

// Represents leech devices deployed by players.
model Leech {
  leech_id Int  @id @default(autoincrement()) @unique @db.UnsignedInt // SQL: leech_id int(11) unsigned NOT NULL auto_increment
  login_id Int  // Login ID of the owner. SQL: login_id int(11) NOT NULL default '0'
  owner    User @relation("UserLeeches", fields: [login_id], references: [login_id])
  task     Int  @default(0) @db.TinyInt // Task the leech is performing. SQL: task tinyint(4) NOT NULL default '0'
  ship_id  Int  // ID of the ship the leech is attached to or deployed from. SQL: ship_id int(11) NOT NULL default '0'
  ship     Ship @relation("ShipLeeches", fields: [ship_id], references: [ship_id])
  shield   Int  @default(0) // Shield strength of the leech. SQL: shield int(11) NOT NULL default '0'
}

// Represents private messages between players.
model Message {
  message_id  Int    @id @default(autoincrement()) // Unique identifier for the message.
  sender_name String @default("") // Name of the sender.
  timestamp   Int    @default(0) // Timestamp of the message.
  login_id    Int    @default(0) // Login ID of the recipient.
  recipient   User   @relation("ReceivedMessages", fields: [login_id], references: [login_id]) // login_id is recipient
  text        Bytes // Content of the message. SQL: blob NOT NULL
  sender_id   Int    // Login ID of the sender. SQL: sender_id int(11) NOT NULL default '1'
  actual_sender User @relation("SentMessages", fields: [sender_id], references: [login_id])
  clan_id     Int    @default(0) // Clan ID associated with the message (if any).
  cat         Int    @default(0) // Category of the message.

  @@index([login_id])
  @@index([timestamp])
}

// Represents mines laid by players.
model Mine {
  mine_id    Int    @id @default(autoincrement()) @unique // Unique identifier for the mine.
  login_id   Int     // Login ID of the owner. SQL: login_id int(11) NOT NULL default '0'
  owner      User    @relation("UserMines", fields: [login_id], references: [login_id])
  login_name String  @default("") @db.VarChar(30) // Name of the owner.
  mine_type  Int     @default(0) @db.TinyInt // Type of the mine. SQL: tinyint(4) NOT NULL default '0'
  clan_id    Int?    // Clan ID of the owner. SQL: clan_id int(11) NOT NULL default '0'. Nullable if 0 means no clan.
  clan       Clan?   @relation("ClanMines", fields: [clan_id], references: [clan_id])
  v_clan_id  Int     @default(0) // ID of a victim clan (if applicable).
  cluster    Int     @default(0) // Cluster ID the mine belongs to.
  rel_target Int     @default(0) @db.TinyInt // SQL: tinyint(4) NOT NULL default '0'
  location   Int     // Location (star system ID) of the mine. SQL: location int(11) NOT NULL default '0'
  star       Star    @relation("StarMines", fields: [location], references: [star_id])
  sequence   Int     @default(0) @db.TinyInt // SQL: tinyint(4) NOT NULL default '0'
}

// Represents Non-Aggression Pacts between entities.
model Nap {
  nap_id     Int     @id @default(autoincrement()) @unique // Unique identifier for the NAP.
  propose_id Int     @default(0) // ID of the proposing entity.
  accept_id  Int     @default(0) // ID of the accepting entity.
  prop_time  Int     @default(0) // Timestamp of the proposal.
  start_time Int     @default(0) // Timestamp when the NAP starts.
  end_time   Int     @default(0) // Timestamp when the NAP ends.
  activated  Boolean @default(false) // Whether the NAP is currently active.
  processed  Boolean @default(false) // Whether the NAP has been processed.
}

// Represents news headlines in the game.
model News {
  news_id   Int    @id @default(autoincrement()) // Unique identifier for the news item.
  timestamp Int    @default(0) // Timestamp of the news.
  login_id  Int    // Login ID related to the news (e.g., player involved). SQL: login_id int(11) NOT NULL default '0'
  user      User   @relation("UserNews", fields: [login_id], references: [login_id])
  headline  String @db.Text // The news headline text.

  @@index([news_id])
  @@index([timestamp])
}

// Represents maintenance news headlines.
model NewsMaint {
  news_id   Int    @id @default(autoincrement()) // Unique identifier for the maintenance news.
  timestamp Int    @default(0) // Timestamp of the news.
  login_id  Int    @default(0) // Login ID related to the news.
  headline  String // The maintenance news headline.

  @@index([news_id])
  @@index([timestamp])
}

// Represents user permissions.
model Permission {
  login_id  Int         @id @unique // Login ID of the user (primary key and unique).
  user      UserAccount @relation(fields: [login_id], references: [login_id])
  god       Boolean     @default(false) // God-level permissions.
  admin     Boolean     @default(false) // Administrator permissions.
  forum     Boolean @default(false) // Forum moderator permissions.
  developer Boolean @default(false) // Developer permissions.
}

// Represents planets in the game.
model Planet {
  planet_id      Int     @id @default(autoincrement()) // Unique identifier for the planet.
  planet_name    String  @default("") @db.VarChar(30)
  planet_type    Int     @default(0)
  location       Int     @default(0) @db.UnsignedInt // Location (star system ID) of the planet.
  star           Star    @relation("PlanetsInStar", fields: [location], references: [star_id])
  owner_id       Int?    // Login ID of the planet owner. SQL: owner_id int(11) NOT NULL default '0'. Made nullable if 0 means no owner.
  owner          User?   @relation("PlanetOwner", fields: [owner_id], references: [login_id]) // Can be Nobody
  owner_name     String  @default("Nobody") @db.VarChar(30)
  fighters       Int     @default(20) @db.UnsignedInt
  colon          Int     @default(1000) @db.UnsignedInt
  fortress_level Int     @default(0)
  fighter_set    Int     @default(0)
  cash           Int     @default(0)
  tax_rate       Int     @default(5)
  clan_id        Int     @default(-1) // Clan ID controlling the planet.
  metal          Int     @default(0) @db.UnsignedInt
  fuel           Int     @default(0) @db.UnsignedInt
  elect          Int     @default(0) @db.UnsignedInt
  organ          Int     @default(0) @db.UnsignedInt
  alloc_fight    Int     @default(0)
  alloc_elect    Int     @default(0)
  alloc_organ    Int     @default(0)
  pass           String  @default("0") @db.VarChar(30)
  planet_img     Int?    @db.TinyInt // SQL: tinyint(255) default NULL
  shield_gen     Boolean @default(false) // SQL: tinyint(255) NOT NULL default '0'
  shield_charge  Int     @default(0)
  launch_pad     Float   @default(0)
  missile        Int     @default(0)
  tech           Int     @default(0)
  research_fac   Boolean @default(false) // SQL: tinyint(255) NOT NULL default '0'
  darkmatter     Int     @default(0)
  wormhole_gen   Boolean @default(false) // SQL: tinyint(4) NOT NULL default '0'
  wormhole       Int     @default(0)
  barren         Boolean @default(false) // SQL: tinyint(4) NOT NULL default '0'
  pop_limit      Int     @default(0)
  unigen         Boolean @default(false) // SQL: tinyint(4) NOT NULL default '0'
  super_hostile  Int     @default(0)

  @@index([location])
  @@index([owner_id])
}

// Represents political positions in the game.
model Politic {
  position_id   Int    @id @unique // SQL: position_id int(11) NOT NULL default '0'
  position_name String @default("") @db.VarChar(30)
  login_id      Int?   // Login ID of the player holding the position. SQL: login_id int(11) NOT NULL default '0'. Nullable if 0 means no holder.
  holder        User?  @relation("PoliticalHolder", fields: [login_id], references: [login_id])
  login_name    String @default("") @db.VarChar(30)
  timestamp     Int    @default(0)
}

// Represents star ports in star systems.
model Port {
  port_id   Int  @id @default(autoincrement()) // Unique identifier for the port.
  location  Int  @default(0) // Location (star system ID) of the port.
  star      Star @relation("PortsInStar", fields: [location], references: [star_id])
  metal     Int  @default(0) // Amount of metal available at the port.
  fuel      Int  @default(0) // Amount of fuel available at the port.
  elect     Int @default(0) // Amount of electronics available at the port.
  organ     Int @default(0) // Amount of organics available at the port.
  metal_cap Int @default(0) // Maximum metal capacity of the port.
  fuel_cap  Int @default(0) // Maximum fuel capacity of the port.
  elect_cap Int @default(0) // Maximum electronics capacity of the port.
  organ_cap Int @default(0) // Maximum organics capacity of the port.

  @@index([location])
}

// Represents game resources and their properties.
model Resource {
  resource_id    Int     @id @default(autoincrement()) @unique // Unique identifier for the resource.
  resource_categ Int     @default(1) // Category of the resource.
  name           String  @default("Scrap (Unknown Material)") // Name of the resource.
  sql_name       String  @default("scrap") // SQL table name for the resource.
  sell_price     Int     @default(0) // Selling price of the resource.
  cost_price     Int     @default(0) // Cost price of the resource.
  uv_percent     Int     @default(0) // Percentage chance of appearing during universe generation.
  uv_max_amount  Int     @default(0) // Maximum amount during universe generation.
  uv_min_amount  Int     @default(0) // Minimum amount during universe generation.
  rr_max_chance  Int     @default(0) // Maximum chance for random resource events.
  rr_min_chance  Int     @default(0) // Minimum chance for random resource events.
  description    String? // Description of the resource.
}

// Represents player-owned ships.
model Ship {
  ship_id            Int     @id @default(autoincrement()) // Unique identifier for the ship.
  ship_name          String  @default("") // Name of the ship.
  login_id           Int?    // Login ID of the ship owner. SQL: login_id int(11) NOT NULL default '0'. Nullable if 0 means no owner.
  owner              User?   @relation("UserShips", fields: [login_id], references: [login_id])
  login_name         String  @default("Nobody") @db.VarChar(30)
  clan_id            Int?    // Clan ID the ship belongs to. SQL: clan_id int(11) NOT NULL default '-1'. Nullable.
  clan               Clan?   @relation("ClanShips", fields: [clan_id], references: [clan_id])
  location           Int     @default(1) // Current location (star system ID) of the ship.
  star               Star    @relation("ShipsInSystem", fields: [location], references: [star_id])
  ship_categ         Int     @default(0) @db.TinyInt // SQL: ship_categ tinyint(4) NOT NULL default '0'
  type               String  @default("0") @db.VarChar(150) // Type/class of the ship. (Denormalized name?) SQL: type varchar(150) NOT NULL default '0'
  ship_type_id       Int     @default(0) @db.UnsignedInt // Was shipclass. Assumed FK to ShipType.type_id. SQL: shipclass int(11) NOT NULL default '0'
  ship_type_info     ShipType @relation(fields: [ship_type_id], references: [type_id])
  class_name         String  @default("0") @db.VarChar(30)
  class_name_abbr    String  @default("0") @db.VarChar(10)
  shields            Int     @default(0) // Current shield strength.
  max_shields        Int     @default(0) // Maximum shield strength.
  fighters           Int     @default(0) // Number of fighters on board.
  max_fighters       Int     @default(0) // Maximum fighter capacity.
  cargo_bays         Int     @default(0) // Number of cargo bays.
  metal              Int     @default(0) // Metal cargo.
  fuel               Int     @default(0) // Fuel cargo.
  darkmatter         Int     @default(0) // Dark matter cargo.
  elect              Int     @default(0) // Electronics cargo.
  organ              Int     @default(0) // Organics cargo.
  colon              Int     @default(0) // Colonists on board.
  mine_mode          Int     @default(0) // Mining mode.
  mine_rate_metal    Int     @default(0) // Metal mining rate.
  mine_rate_fuel     Int     @default(0) // Fuel mining rate.
  mine_rate_darkmatter Int   @default(0) @db.UnsignedInt
  mine_rate          Int     @default(0) @db.UnsignedInt
  move_turn_cost     Int     @default(1) @db.UnsignedInt
  config             String  @db.Text // Ship configuration string. SQL: text NOT NULL
  size               Int     @default(1) @db.TinyInt // SQL: size tinyint(4) NOT NULL default '1'
  disp_rank          Int     @default(0) @db.TinyInt // SQL: disp_rank tinyint(4) NOT NULL default '0'
  upgrades           Int     @default(0) // Number of upgrades installed.
  point_value        Int     @default(0) // Point value of the ship for scoring.
  num_ot             Int     @default(0) // Number of offensive turrets.
  num_dt             Int     @default(0) // Number of defensive turrets.
  num_pc             Int     @default(0) // Number of plasma cannons.
  num_sa             Int     @default(0) // Number of sensor arrays.
  num_ew             Int     @default(0) // Number of electronic warfare systems.
  num_mi             Int     @default(0) // Number of missile launchers.
  tech_bonus         Int     @default(0) // Technology bonus.
  leech              Boolean @default(false) // Whether the ship has leech capability.
  missiles           Int     @default(0) // Number of standard missiles.
  dmissiles          Int     @default(0) // Number of defensive missiles.
  bonus_attack       Boolean @default(false) // Bonus attack capability.
  defend_fleet       Boolean @default(false) // Fleet defense capability.
  shield_1           Int     @default(0) // Shield strength sector 1.
  shield_2           Int     @default(0) // Shield strength sector 2.
  shield_3           Int     @default(0) // Shield strength sector 3.
  shield_4           Int     @default(0) // Shield strength sector 4.
  shield_5           Int     @default(0) // Shield strength sector 5.
  shield_charge      Int     @default(0) // Shield charge rate.
  max_charge         Int     @default(0) @db.UnsignedInt
  shield_prts        Int     @default(0) @db.UnsignedInt
  fleet_id           Int?    // ID of the fleet the ship belongs to. SQL: fleet_id int(11) unsigned NOT NULL default '0'. Nullable if 0 means no fleet.
  fleet              Fleet?  @relation("ShipsInFleet", fields: [fleet_id], references: [fleet_id])
  timestamp          Int     @default(0) @db.UnsignedInt
  leeches_on_ship    Leech[]            @relation("ShipLeeches")
  upgrades_installed UpgradeUnit[]      @relation("ShipUpgrades")
  transfer_entries   TransferBuffer[]   @relation("ShipTransferEntries")


  @@index([location])
  @@index([fighters])
  @@index([fleet_id])
  @@index([login_id])
}

// Represents alien shipyards.
model Shipyard {
  asyrd_id BigInt @id @default(autoincrement())
  location Int    @default(0) // Location (star system ID) of the shipyard. SQL was BigInt, changed to Int to match Star.star_id
  star     Star   @relation("ShipyardsInStar", fields: [location], references: [star_id])
  move     BigInt @default(0) // SQL: bigint(255) NOT NULL default '0'
}

// Represents star systems in the game universe.
model Star {
  star_id         Int     @id @default(autoincrement()) // Unique identifier for the star system.
  star_name       String  @default("") // Name of the star system.
  sys_type        Int     @default(0) // Type of the star system.
  x_loc           Int     @default(0) // X-coordinate of the star system on the map.
  y_loc           Int     @default(0) // Y-coordinate of the star system on the map.
  link_1          Int     @default(0) // ID of the first linked star system (for warp gates/lanes).
  link_2          Int     @default(0) // ID of the second linked star system.
  link_3          Int     @default(0) // ID of the third linked star system.
  link_4          Int     @default(0) // ID of the fourth linked star system.
  link_5          Int     @default(0) // ID of the fifth linked star system.
  link_6          Int     @default(0) // ID of the sixth linked star system.
  metal           Int     @default(0) // Metal resources in the system.
  fuel            Int     @default(0) // Fuel resources in the system.
  darkmatter      Int     @default(0) // Dark matter in the system.
  planetary_slots Int     @default(0) // Number of available planetary slots.
  event_random    Int     @default(0) // Random event trigger/status.
  wormhole        Int     @default(0) // Wormhole presence/destination.
  art_wh          Int     @default(0) // Artificial wormhole status.
  wh_login        Int     @default(0) // Login ID associated with the wormhole.
  wh_clanid       Int     @default(0) // Clan ID associated with the wormhole.
  unigen          Int     @default(0) // Universe generation marker.
  t_a             Int     @default(0) // Tactical advantage indicator.
  bmrkts            Bmrkt[]            @relation("BmrktInStar")
  fleets_in_system  Fleet[]            @relation("FleetsInSystem")
  mines_in_system   Mine[]             @relation("StarMines")
  planets_in_system Planet[]           @relation("PlanetsInStar")
  ports_in_system   Port[]             @relation("PortsInStar")
  ships_in_system   Ship[]             @relation("ShipsInSystem")
  shipyards_in_system Shipyard[]         @relation("ShipyardsInStar")
  users_in_system   User[]             @relation("UsersInSystem")


  @@index([star_id, star_name])
}

// Represents a buffer for ship transfers between players.
model TransferBuffer {
  buffer_id     Int    @id @default(autoincrement()) @unique @db.UnsignedInt // SQL: buffer_id int(11) unsigned NOT NULL auto_increment
  owner_id      Int    @db.UnsignedInt // Login ID of the current owner. SQL: owner_id int(11) unsigned NOT NULL default '0'
  owner         User   @relation("OwnedTransfers", fields: [owner_id], references: [login_id])
  ship_id       Int    @db.UnsignedInt // ID of the ship being transferred. SQL: ship_id int(11) unsigned NOT NULL default '0'
  ship          Ship   @relation("ShipTransferEntries", fields: [ship_id], references: [ship_id])
  ship_categ    Int    @default(0) @db.UnsignedInt // SQL: ship_categ int(11) unsigned NOT NULL default '0'
  class_name    String @default("0") @db.VarChar(32) // SQL: class_name varchar(32) NOT NULL default '0'
  transferto_id Int    @db.UnsignedInt // Login ID of the recipient. SQL: transferto_id int(11) unsigned NOT NULL default '0'
  recipient     User   @relation("ReceivedTransfers", fields: [transferto_id], references: [login_id])
  timestamp     Int    @default(0) @db.UnsignedInt // SQL: timestamp int(11) unsigned NOT NULL default '0'
}

// Represents upgrade units installed on ships.
model UpgradeUnit {
  upg_record          Int   @id @default(autoincrement()) @unique @db.UnsignedInt // SQL: upg_record int(11) unsigned NOT NULL auto_increment
  ship_id             Int   @db.UnsignedInt // ID of the ship the upgrades are on. SQL: ship_id int(11) unsigned NOT NULL default '0'
  ship                Ship  @relation("ShipUpgrades", fields: [ship_id], references: [ship_id])
  fleet_id            Int?  @db.UnsignedInt // ID of the fleet the ship belongs to. SQL: fleet_id int(11) unsigned NOT NULL default '0'. Made nullable.
  fleet               Fleet? @relation("FleetUpgradesCache", fields: [fleet_id], references: [fleet_id])
  login_id            Int   @db.UnsignedInt // Login ID of the owner. SQL: login_id int(11) unsigned NOT NULL default '0'
  owner               User  @relation("UserUpgradeRecords", fields: [login_id], references: [login_id])
  clan_id             Int?  @db.UnsignedInt // Clan ID of the owner. SQL: clan_id int(11) unsigned NOT NULL default '0'. Made nullable.
  clan                Clan? @relation("ClanUpgradeRecords", fields: [clan_id], references: [clan_id])
  pass_sensor         Int   @default(0) @db.UnsignedInt
  stand_scanner       Int   @default(0) @db.UnsignedInt
  adv_scanner         Int   @default(0) @db.UnsignedInt
  grav_scanner        Int   @default(0) @db.UnsignedInt
  subs_array          Int   @default(0) @db.UnsignedInt
  alien_array         Int   @default(0) @db.UnsignedInt
  stand_cloak         Int   @default(0) @db.UnsignedInt
  adv_cloak           Int   @default(0) @db.UnsignedInt
  pir_deflect         Int   @default(0) @db.UnsignedInt
  spat_unit           Int   @default(0) @db.UnsignedInt
  dim_flux            Int   @default(0) @db.UnsignedInt
  laser_cannon        Int   @default(0) @db.UnsignedInt
  thor_hammer         Int   @default(0) @db.UnsignedInt
  emp_disruptor       Int   @default(0) @db.UnsignedInt
  plasma_cannon       Int   @default(0) @db.UnsignedInt
  einstein_projector  Int   @default(0) @db.UnsignedInt
  laser_ward          Int   @default(0) @db.UnsignedInt
  flak_cannon         Int   @default(0) @db.UnsignedInt
  emp_blaster         Int   @default(0) @db.UnsignedInt
  silicon_armour      Int   @default(0) @db.UnsignedInt
  shield_charger      Int   @default(0) @db.UnsignedInt
  wormhole_stabiliser Int   @default(0) @db.UnsignedInt
  trans_drive         Int   @default(0) @db.UnsignedInt
  ramscoop            Int   @default(0) @db.UnsignedInt
}

// Represents items available in the used items market.
model UsedItem {
  item_id   Int     @id @default(autoincrement()) @unique @db.UnsignedInt // SQL: item_id int(11) unsigned NOT NULL auto_increment
  item_name String  @default("") @db.VarChar(30)
  item_code String  @default("") @db.VarChar(30)
  item_type Int     @default(0) @db.UnsignedInt
  race      Int     @default(0) @db.TinyInt // SQL: race tinyint(4) NOT NULL default '0'
  config    String  @default("") @db.VarChar(30)
  owner_id  Int?    @db.UnsignedInt // Login ID of the item owner. SQL: owner_id int(11) unsigned NOT NULL default '0'. Made nullable.
  owner     User?   @relation("UserUsedItems", fields: [owner_id], references: [login_id])
  price     Int     @default(0) @db.UnsignedInt
  timestamp Int     @default(0) @db.UnsignedInt
  active    Boolean @default(false) // SQL: active tinyint(4) NOT NULL default '0'
  ship_id   Int     @default(0) @db.UnsignedInt
  ship_type Int     @default(0) @db.UnsignedInt
  units     Int     @default(0) @db.UnsignedInt
}

// Represents user-specific options and preferences.
model UserOption {
  login_id              Int         @id @unique // Login ID of the user (primary key).
  user                  UserAccount @relation("UserAccountOptions", fields: [login_id], references: [login_id])
  color_scheme          Int         @default(1) // Preferred color scheme.
  theme                 String      @default("red_Tempest") // Preferred theme.
  news_back             Int     @default(200) // News display setting.
  forum_back            Int     @default(48) // Forum display setting.
  show_sigs             Boolean @default(true) // Whether to show signatures in forums.
  show_pics             Boolean @default(true) // Whether to show pictures.
  show_minimap          Boolean @default(true) // Whether to show the minimap.
  allow_popups          Boolean @default(true) // Whether to allow popups.
  show_config           Boolean @default(false) // Whether to show configuration details.
  show_aim              Boolean @default(false) // AIM display setting.
  show_icq              Boolean @default(false) // ICQ display setting.
  planet_report         Boolean @default(true) // Planet report setting.
  show_clan_ships       Boolean @default(true) // Whether to show clan ships.
  show_abbr_ship_class  Boolean @default(true) // Whether to show abbreviated ship classes.
  show_rel_sym          Boolean @default(true) // Whether to show relation symbols.
  enable_fleets         Boolean @default(true) // Whether to enable fleet functionality.
  Status_Hidden         Boolean @default(false) // Whether user status is hidden.
}

// Represents users in the game.
// This model corresponds to QUANTUM_users (game-specific user data)
model User {
  login_id               Int         @id @db.UnsignedInt // PK, FK to UserAccount.login_id. NOT auto-increment.
  user_account           UserAccount @relation("UserAccountGameInstances", fields: [login_id], references: [login_id])
  login_name             String      @default("") @db.VarChar(120) // Not unique. SQL: login_name varchar(120) NOT NULL default ''
  race                   Int         @default(0) @db.TinyInt
  joined_game            Int         @default(0) @db.UnsignedInt
  game_login_count       Int         @default(0) @db.UnsignedInt
  turns                  Int         @default(40) @db.UnsignedInt
  turns_run              Int         @default(0) @db.UnsignedInt
  location               Int         @default(1) @db.UnsignedInt // Foreign key to Star.star_id
  current_star           Star?       @relation("UsersInSystem", fields: [location], references: [star_id])
  ship_id                Int         @default(1) @db.UnsignedInt
  cash                   BigInt      @default(100000) @db.UnsignedBigInt
  tech                   Int         @default(0) @db.UnsignedInt
  on_planet              Int         @default(0) @db.UnsignedInt
  last_attack            Int         @default(1) @db.UnsignedInt
  last_attack_by         String      @default("") @db.VarChar(30)
  ships_killed           Int         @default(0) @db.UnsignedInt
  ships_lost             Int         @default(0) @db.UnsignedInt
  ships_killed_points    Int         @default(0) @db.UnsignedInt
  ships_lost_points      Int         @default(0) @db.UnsignedInt
  show_enemy_ships       Int         @default(0) @db.UnsignedInt
  show_user_ships        Int         @default(0) @db.UnsignedInt
  genesis                Int         @default(0) @db.UnsignedInt
  terra_imploder         Int         @default(0) @db.UnsignedInt
  clan_id                Int?        @db.UnsignedInt // SQL: clan_id int(11) unsigned NOT NULL default '0'
  clan                   Clan?       @relation(fields: [clan_id], references: [clan_id])
  clan_sym               String      @default("") @db.Char(3)
  clan_sym_color         String      @default("") @db.VarChar(6)
  clan_leader            Boolean     @default(false) // SQL: tinyint(4) NOT NULL default '0'
  v_clan_id              Int         @default(0) @db.UnsignedInt
  nap_id                 Int         @default(0) @db.TinyInt // SQL: int(4) NOT NULL default '0'
  fighters_killed        Int         @default(0) @db.UnsignedInt
  fighters_lost          Int         @default(0) @db.UnsignedInt
  bounty                 Int         @default(0) @db.UnsignedInt
  score                  Int         @default(0) @db.UnsignedInt
  alien                  Int         @default(0) @db.UnsignedInt
  pirate                 Int         @default(0) @db.UnsignedInt
  alpha                  Int         @default(0) @db.UnsignedInt
  gamma                  Int         @default(0) @db.UnsignedInt
  delta                  Boolean     @default(false) // SQL: tinyint(4) NOT NULL default '0'
  sn_effect              Boolean     @default(false) // SQL: tinyint(4) NOT NULL default '0'
  politics               Int         @default(0) @db.UnsignedInt
  sig                    String      @default("") @db.VarChar(150)
  last_request           Int         @default(0) @db.UnsignedInt
  last_access_forum      Int         @default(0) @db.UnsignedInt
  last_access_clan_forum Int         @default(0) @db.UnsignedInt
  last_access_news       Int         @default(0) @db.UnsignedInt
  last_access_maint_news Int         @default(0) @db.UnsignedInt
  last_access_inbox      Int         @default(0) @db.UnsignedInt
  banned_time            Int         @default(0) @db.UnsignedInt
  banned_reason          String      @db.Text // SQL: blob NOT NULL, assumed text
  one_brob               Boolean     @default(false) // SQL: tinyint(11) unsigned NOT NULL default '0'
  second_scatter         Boolean     @default(false) // SQL: tinyint(4) NOT NULL default '0'
  event                  Boolean     @default(false) // SQL: tinyint(4) NOT NULL default '0'
  sideffect              Boolean     @default(false) // SQL: tinyint(4) NOT NULL default '0'
  grav_mine              Int         @default(0) @db.UnsignedInt
  hornet_mine            Int         @default(0) @db.UnsignedInt
  leech                  Int         @default(0) @db.UnsignedInt
  tachyon_comm           Int         @default(0) @db.UnsignedInt
  bm_visit               Int         @default(0) @db.UnsignedInt
  overdue                Boolean     @default(false) // SQL: tinyint(4) NOT NULL default '0'
  outlaw                 Boolean     @default(false) // SQL: tinyint(4) NOT NULL default '0'
  ramscoop               Boolean     @default(false) // SQL: tinyint(4) NOT NULL default '0'
  // email_address field removed, exists in UserAccount
  last_ss                BigInt      @db.UnsignedBigInt // SQL: bigint(255) NOT NULL

  // bank_account should be on UserAccount
  bilko_bids              Bilko[]            @relation("BilkoBids")
  clan_forum_messages     ClanForumMessage[] @relation("ClanForumSender")
  diary_entries           DiaryEntry[]       @relation("UserDiaryEntries")
  fines                   Fine[]             @relation("UserFines")
  fleets                  Fleet[]            @relation("UserFleets")
  game_forum_messages     GameForumMessage[] @relation("UserGameForumMessages")
  leeches_owned           Leech[]            @relation("UserLeeches")
  messages_received       Message[]          @relation("ReceivedMessages")
  messages_sent           Message[]          @relation("SentMessages")
  mines_owned             Mine[]             @relation("UserMines")
  news_items              News[]             @relation("UserNews")
  owned_planets           Planet[]           @relation("PlanetOwner")
  political_position      Politic?           @relation("PoliticalHolder")
  ships                   Ship[]             @relation("UserShips")
  owned_transfers         TransferBuffer[]   @relation("OwnedTransfers")
  receiving_transfers     TransferBuffer[]   @relation("ReceivedTransfers")
  upgrade_records         UpgradeUnit[]      @relation("UserUpgradeRecords")
  items_for_sale          UsedItem[]         @relation("UserUsedItems")
  user_options            UserOption?
  permissions             Permission?

  @@index([ships_killed])
  @@index([turns_run])
  // Note: login_name is not indexed here as it's not unique and likely not a primary search key for this table directly
}

