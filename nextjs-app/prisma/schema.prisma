  mine_rate_metal      Int     @default(0) @db.UnsignedInt
  mine_rate_fuel       Int     @default(0) @db.UnsignedInt
  mine_rate_darkmatter Int     @default(0) @db.UnsignedInt
  mine_rate            Int     @default(0) @db.UnsignedInt
  descr                String  @db.Text
  size                 Int     @default(0) @db.TinyInt
  config               String  @db.VarChar(30)
  upgrades             Int     @default(0) @db.UnsignedInt
  auction              Boolean @default(false) @db.TinyInt // SQL: tinyint(4) NOT NULL default '0'
  move_turn_cost       Int     @default(1) @db.UnsignedInt
  point_value          Int     @default(0) @db.UnsignedInt
  tech_bonus           Int     @default(0) @db.UnsignedInt
  bonus_attack         Boolean @default(false) @db.TinyInt // SQL: tinyint(4) NOT NULL default '0'
  num_pc               Int     @default(0) @db.UnsignedInt
  num_ot               Int     @default(0) @db.UnsignedInt
  num_dt               Int     @default(0) @db.UnsignedInt
  num_sa               Int     @default(0) @db.UnsignedInt
  num_ew               Int     @default(0) @db.UnsignedInt
  num_mi               Int     @default(0) @db.UnsignedInt
  upg_index            String  @db.VarChar(10)
  shield_1             Int     @default(0) @db.UnsignedInt
  shield_2             Int     @default(0) @db.UnsignedInt
  shield_3             Int     @default(0) @db.UnsignedInt
  shield_4             Int     @default(0) @db.UnsignedInt
  shield_5             Int     @default(0) @db.UnsignedInt
  shield_charge        Int     @default(0) @db.UnsignedInt
  max_charge           Int     @default(0) @db.UnsignedInt
  shield_prts          Int     @default(0) @db.UnsignedInt

  admin_ship_configs AdminShip[]
  default_upgrades   DefaultUpgradeLoad?
  ships              Ship[]              @relation(references: [ship_type_id]) // Inverse of Ship.ship_type_info

  @@index([type_id])
}

model UpgradeList {
  item_id  Int    @id @default(autoincrement()) @unique @db.UnsignedInt
  name     String @db.VarChar(96)
  era_id   Int    @db.TinyInt // Was 'era'
  era_ref  Era    @relation("EraUpgrades", fields: [era_id], references: [era_id])
  race_id  Int    @db.TinyInt // Was 'race'
  race_ref Race   @relation("RaceUpgrades", fields: [race_id], references: [race_ID])
  type     Int    @db.TinyInt
  level    Int    @db.TinyInt
  seller   Int    @db.TinyInt
  cost     Int    @db.UnsignedInt
  tech     Int    @db.UnsignedInt
  sql_name String @db.VarChar(96)
  inc      Int    @db.UnsignedInt
  damage   Int    @db.UnsignedInt
  lim      Int    @db.UnsignedInt
  abbrev   String @db.VarChar(5)
  info     String @db.VarChar(96)
}
