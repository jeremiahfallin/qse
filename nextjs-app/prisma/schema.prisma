// From user_accounts.sql
// This model corresponds to user_accounts (global user data)
model UserAccount {
  login_id             Int     @id @default(autoincrement())
  login_name           String  @unique @db.VarChar(30)
  passwd               String  @db.VarChar(45) // Should be hashed
  auth                 Int     @default(0) // SQL: auth int(11) NOT NULL default '0'
  first_name           String  @default("") @db.VarChar(30) // SQL: first_name varchar(30) NOT NULL default ''
  last_name            String  @default("") @db.VarChar(30) // SQL: last_name varchar(30) NOT NULL default ''
  email_address        String  @unique @db.VarChar(40) // SQL: email_address varchar(40) NOT NULL default ''
  icq                  Int     @default(0) // SQL: icq int(11) NOT NULL default '0'
  aim                  String  @default("") @db.VarChar(50) // SQL: aim varchar(50) NOT NULL default ''
  msn                  String  @default("") @db.VarChar(50) // SQL: msn varchar(50) NOT NULL default ''
  yim                  String  @default("") @db.VarChar(50) // SQL: yim varchar(50) NOT NULL default ''
  signed_up            Int     @default(0) // SQL: signed_up int(11) NOT NULL default '0'
  session_exp          Int     @default(0) // SQL: session_exp int(11) NOT NULL default '0'
  session_id           Int     @default(0) // SQL: session_id int(11) NOT NULL default '0'
  last_login           Int     @default(0) // SQL: last_login int(11) NOT NULL default '0'
  login_count          Int     @default(0) // SQL: login_count int(11) NOT NULL default '0'
  last_ip              String  @default("") @db.VarChar(16) // SQL: last_ip varchar(16) NOT NULL default ''
  num_games_joined     Int     @default(0) // SQL: num_games_joined int(11) NOT NULL default '0'
  total_score          Int     @default(0) // SQL: total_score int(11) NOT NULL default '0'
  con_speed            Int     @default(2) @db.TinyInt // SQL: con_speed tinyint(4) NOT NULL default '2'
  default_color_scheme Int     @default(1) @db.TinyInt // SQL: default_color_scheme tinyint(4) NOT NULL default '1'
  country              String  @default("") @db.VarChar(150) // SQL: country varchar(150) NOT NULL default ''
  hear_from            String  @default("") @db.VarChar(150) // SQL: hear_from varchar(150) NOT NULL default ''
  e_list               Boolean @default(true) // SQL: e_list tinyint(4) NOT NULL default '1'
  birth_date           Int     @default(0) // SQL: birth_date int(11) NOT NULL default '0'
  sex                  Int     @default(0) @db.TinyInt // SQL: sex tinyint(4) NOT NULL default '0'
  hint_question        String  @default("") @db.Text // SQL: hint_question text NOT NULL
  hint_answer          String  @default("") @db.Text // SQL: hint_answer text NOT NULL
  newsletter           Boolean @default(false) // SQL: newsletter tinyint(4) NOT NULL default '0'

  game_instances User[]        @relation("UserAccountGameInstances")
  bank_account   BankAccount?
  permissions    Permission?   @relation(references: [login_id])
  user_options   UserOption?   @relation("UserAccountOptions")
}

model UserHistory {
  login_id   Int
  timestamp  Int
  game_db    String @db.VarChar(30)
  action     String @db.Text
  user_IP    String @db.VarChar(16)
  other_info String @db.Text
  // This table doesn't have a primary key in the SQL.
